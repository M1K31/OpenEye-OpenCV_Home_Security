# =============================================================================
# OpenEye — example environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you need. The automated
# installer (./setup-production.sh) generates the secret keys for you; you only
# need to set them by hand for a manual install. Anything left unset uses a safe
# default. NEVER commit your real .env — it is gitignored.
#
# This lists the settings most people touch. Many more advanced flags exist in
# backend/core/config.py (camera timeouts, clustering thresholds, feature
# toggles, cleanup schedules, etc.).
# =============================================================================

# --- Secrets (REQUIRED) ------------------------------------------------------
# Generate strong, unique values. On a manual install:
#   python3 -c "import secrets; print(secrets.token_hex(32))"   # SECRET_KEY / JWT_SECRET_KEY
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # NOTIFICATION_ENCRYPTION_KEY
SECRET_KEY=
JWT_SECRET_KEY=
# Encrypts stored notification-provider credentials (Fernet key). Optional if
# you do not configure notification providers.
NOTIFICATION_ENCRYPTION_KEY=

# --- Authentication ----------------------------------------------------------
ALGORITHM=HS256
# Access-token lifetime in minutes. Keep this SHORT: the frontend silently renews
# it using the refresh token (rotated on every use), so a short window costs nothing
# in re-logins but limits the damage if an access token is stolen.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in days — this is what controls how long a session can be
# resumed without signing in again. Refresh tokens are single-use: each refresh
# issues a new one and revokes the old, and replaying a spent token revokes every
# refresh token for that user (theft detection).
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ----------------------------------------------------------------
# SQLite (default, zero-config) or PostgreSQL for production.
DATABASE_URL=sqlite:///./surveillance.db
# DATABASE_URL=postgresql://user:password@localhost:5432/openeye

# --- Network / CORS ----------------------------------------------------------
# Port the server binds to (local installs default to 8200; Docker uses 8000).
PORT=8200
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8200
CORS_ALLOW_CREDENTIALS=true
# Ecosystem integration is off by default. If you run the companion registry,
# set this true and provide an explicit origin regex (never a wildcard).
CORS_ALLOW_ECOSYSTEM=false
# CORS_ORIGIN_REGEX=^https?://localhost(:\d+)?$

# --- Data directories --------------------------------------------------------
# Where OpenEye stores its data. Defaults live under the project/install dir;
# override to point at a larger disk. Keep faces/recordings on an INTERNAL disk
# (an external drive that unmounts can crash capture) — the UI warns about this.
OPENEYE_DATA_DIR=
OPENEYE_FACES_DIR=
OPENEYE_RECORDINGS_DIR=
OPENEYE_SNAPSHOTS_DIR=
OPENEYE_THUMBNAILS_DIR=

# --- Recording & face clustering ---------------------------------------------
# Video codec to try first: "mp4v" (robust default), "MJPG", or "avc1"/H.264.
# avc1 uses in-process libx264 which can crash under sustained load; mp4v is safest.
OPENEYE_VIDEO_CODEC=mp4v
# Auto cluster+train schedule: "interval" (every N minutes) or "window"
# (only during the low-traffic hours below, to save resources).
OPENEYE_CLUSTER_SCHEDULE_MODE=interval
OPENEYE_CLUSTER_WINDOW_START_HOUR=2
OPENEYE_CLUSTER_WINDOW_END_HOUR=4

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# DEBUG=false

# --- Ecosystem (optional) ----------------------------------------------------
# Only needed if integrating with the companion appEcosystem registry.
# ECOSYSTEM_REGISTRY_URL=http://localhost:8500
# ECOSYSTEM_HMAC_SECRET=
