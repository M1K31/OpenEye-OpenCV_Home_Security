# Documentation - Ignore all except essential docs
# Root level - keep only main docs
*.md
*.md.*
!/README.md
!/CHANGELOG.md
!/DOCKER.md
!/usage.md
!/todos_changelog.md

# Essential docs directory structure
!/docs/
/docs/*
!/docs/USER_GUIDE.md
!/docs/UNINSTALL_GUIDE.md
!/docs/QUICK_REFERENCE.md
!/docs/API_REFERENCE.md
!/docs/deployment/
/docs/deployment/*
!/docs/deployment/setup_guide.md
!/docs/deployment/LINUX_SYSTEMD_SERVICE.md
!/docs/development/
/docs/development/*
!/docs/development/WEBSOCKET_IMPLEMENTATION.md

# Ignore non-essential doc subdirectories entirely
/docs/archived-releases/
/docs/features/
/docs/releases/
/docs/security/
/docs/testing/

# Ignore opencv_surveillance docs (internal development docs)
opencv_surveillance/docs/

# Ignore prompts
.github/prompts/

# Developer files (AI context) - never commit
CLAUDE.md
CLAUDE.md.*
claude.md

# Worktrees
.worktrees/

# --- Documentation policy ---------------------------------------------------
# Only user-facing docs are tracked: README, usage guides, API/user references,
# and changelogs. Agent-generated planning artifacts (plans, specs, findings,
# audits, walkthroughs) stay local and are added only after an explicit
# document review.
docs/superpowers/
*_PLAN.md
*_FINDINGS.md
*_AUDIT.md
AUDIT_*.md
walkthrough.md
WALKTHROUGH.md
