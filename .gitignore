# Worktrees
.worktrees/

# --- Markdown policy --------------------------------------------------------
# Ignore DEVELOPMENT and PROJECT-MANAGEMENT markdown only: plans, specs,
# findings, audits, walkthroughs, progress logs. These stay local and are
# committed only after an explicit document review.
#
# Everything a user needs to run or use the project stays tracked: README,
# usage guides, API/user references, changelogs, licences and trademarks.
#
# IMPORTANT: not all markdown is documentation. The cyber-harness ships
# functional markdown — agents/, skills/, commands/, rules/, contexts/ are
# agent definitions installed into a user's project, and the knowledge_base/
# tree is product content. Never add a blanket *.md rule; it would untrack
# those and silently break the products for anyone cloning.
docs/superpowers/
*_PLAN.md
*_FINDINGS.md
*_AUDIT.md
AUDIT_*.md
walkthrough.md
WALKTHROUGH.md
progress-log.md
PROGRESS.md
STATUS.md

# Local audit/test artifacts and dev-only harness bridge (never ship)
audit_test_results.json
test_photos_audit.py
harness_bridge.py

# Per-machine launch scripts generated by scripts/install-local.sh with absolute
# paths baked in (the tracked copies leaked /Users/<name>/... paths). Generated
# fresh on every install; the checkout must not carry one machine's paths.
/opencv_surveillance/start.sh
/opencv_surveillance/stop.sh

# Build inputs cached locally by scripts/build-macos-app.sh — currently a 15 MB
# relocatable CPython tarball. It is a build input, not source: a `git add -A`
# would otherwise commit an interpreter distribution to the repository.
/.build-cache/

# A built application bundle, wherever it is produced.
*.app/
